{
  "name": "poc-angular-releases",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4200 --host=0.0.0.0 --disable-host-check --open",
    "build": "ng build --configuration production --output-hashing=none --optimization --aot",
    "build:ci": "npm run build -- --base-href=/.",
    "deploy:gh": "ng deploy --base-href=/poc-angular-releases/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test:dev": "npm run test -- --progress --browsers Chrome",
    "test:ci": "npm run test -- --no-watch --no-progress --browsers ChromeHeadlessNoSandbox",
    "prettier:write": "npx prettier --write --ignore-unknown .",
    "prettier:check": "npx prettier --check .",
    "pre-commit": "npx --no-install lint-staged",
    "pre-push": "npm run test:ci",
    "prepare": "husky",
    "postinstall": "chmod ug+x .husky/*",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@angular/router": "^21.2.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.11",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/types": "7.18.0",
    "@typescript-eslint/utils": "7.18.0",
    "angular-cli-ghpages": "^2.0.0-beta.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-spec-reporter": "^0.0.36",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "typescript": "~5.9.0"
  }
}
