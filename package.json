{
  "name": "poc-angular-releases",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4200 --host=0.0.0.0 --disable-host-check --open",
    "build": "ng build --configuration production --output-hashing=none --optimization --aot",
    "build:ci": "npm run build -- --base-href=/.",
    "deploy:gh": "ng deploy --base-href=/poc-angular-releases/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test:dev": "npm run test -- --progress --browsers Chrome",
    "test:ci": "npm run test -- --no-watch --no-progress --browsers ChromeHeadlessNoSandbox",
    "prettier:write": "npx prettier --write --ignore-unknown .",
    "prettier:check": "npx prettier --check .",
    "commitlint": "commitlint --edit $HUSKY_GIT_PARAMS",
    "pre-commit": "npx --no-install lint-staged",
    "security:pre-push": "npm audit --audit-level=moderate",
    "pre-push": "npm run security:pre-push && npm run test:ci",
    "prepare": "husky",
    "postinstall": "chmod ug+x .husky/*",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.6",
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@typescript-eslint/types": "8.64.0",
    "@typescript-eslint/utils": "8.64.0",
    "angular-cli-ghpages": "^3.0.3",
    "eslint": "^8.57.1",
    "husky": "^9.0.11",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-spec-reporter": "^0.0.36",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "typescript": "~6.0.3"
  }
}
